# ====================================================================
# Wolf Cloud Gaming - Systemd Service Template
# ====================================================================
# Como instalar no seu host:
# 1. Copie este arquivo: sudo cp wolf.service /etc/systemd/system/
# 2. Ajuste 'User', 'WorkingDirectory' e (se aplicável) 'RequiresMountsFor'
# 3. Ative o serviço: sudo systemctl daemon-reload && sudo systemctl enable --now wolf
# ====================================================================

[Unit]
Description=Wolf Cloud Gaming Server
Requires=docker.service
After=docker.service network-online.target local-fs.target
Wants=network-online.target
# Se os dados/jogos estiverem em disco secundário, descomente e ajuste o mount:
# RequiresMountsFor=/mnt/storage

[Service]
Type=simple
User=YOUR_USERNAME
Group=docker
WorkingDirectory=/opt/wolf-data
# Limpeza preventiva de qualquer estado fantasma/morto
ExecStartPre=-/usr/bin/docker compose down --remove-orphans
ExecStart=/usr/bin/docker compose up --force-recreate --remove-orphans --abort-on-container-exit --exit-code-from wolf
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
