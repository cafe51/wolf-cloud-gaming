# ====================================================================
# Wolf Cloud Gaming - Systemd Service Template
# ====================================================================
# Como instalar no seu host:
# 1. Copie este arquivo: sudo cp wolf.service /etc/systemd/system/
# 2. Ajuste 'User' e 'WorkingDirectory' conforme seu usuário e caminho
# 3. Ative o serviço: sudo systemctl daemon-reload && sudo systemctl enable --now wolf
# ====================================================================

[Unit]
Description=Wolf Cloud Gaming Server
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
User=YOUR_USERNAME
Group=docker
WorkingDirectory=/opt/wolf-cloud-gaming
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
