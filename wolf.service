# ====================================================================
# Wolf Cloud Gaming - Systemd Service Template
# ====================================================================
# Como instalar no seu host:
# 1. Copie este arquivo: sudo cp wolf.service /etc/systemd/system/
# 2. Ajuste 'User' e 'WorkingDirectory' conforme seu usuário e caminho
# 3. Ative o serviço: sudo systemctl daemon-reload && sudo systemctl enable --now wolf
# ====================================================================

[Unit]
Description=Wolf Cloud Gaming Server
Requires=docker.service
After=docker.service network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/01D808191FE36330

[Service]
Type=oneshot
RemainAfterExit=true
User=japhe
Group=docker
WorkingDirectory=/mnt/01D808191FE36330/ubuntu/programas/wolf-data
# Limpeza preventiva de qualquer estado fantasma/morto
ExecStartPre=-/usr/bin/docker compose down
ExecStart=/usr/bin/docker compose up -d --force-recreate
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
