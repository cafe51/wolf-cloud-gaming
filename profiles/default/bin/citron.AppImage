#!/bin/bash
# NOTA: O EmulationStation (ES-DE) busca estritamente pelo nome 'citron.AppImage'
# nos seletores de emuladores para o sistema Switch. Este script atua como wrapper
# transparente, mantendo a compatibilidade do frontend e iniciando o Ryujinx extraído.

export LD_LIBRARY_PATH=/ryujinx/squashfs-root/usr/lib:$LD_LIBRARY_PATH
exec /ryujinx/squashfs-root/AppRun "$@"
