# ==========================================================
# Wolf Cloud Gaming - Variáveis de Ambiente (Template)
# Copie este arquivo para .env e ajuste para o seu ambiente:
# cp .env.example .env
# ==========================================================

# Diretório base onde este repositório está clonado
WOLF_BASE_DIR=/opt/wolf-data

# Diretório onde as ROMs estão montadas/armazenadas no host
ROMS_DIR=/home/user/roms-gdrive

# Diretório da biblioteca Steam no host (opcional)
STEAM_LIBRARY_DIR=/mnt/storage/games/steam

# Dispositivo de renderização da GPU (DRI render node)
WOLF_RENDER_NODE=/dev/dri/renderD128

# Resolução padrão do compositor virtual
GAMESCOPE_WIDTH=1920
GAMESCOPE_HEIGHT=1080

# Níveis de log
RUST_LOG=info
WOLF_LOG_LEVEL=debug
